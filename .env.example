# Copy to .env and fill in. .env is never served to browsers.
PORT=5173
HOST=127.0.0.1
NODE_ENV=development

# First-run owner account (used only while no admin exists)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Sanskriti

# Business WhatsApp number that receives orders (country code, digits only).
# Can also be changed later in Admin → Settings.
WHATSAPP_NUMBER=

# Optional
# DB_PATH=data/sanskriti.db
# UPLOAD_DIR=uploads
# SESSION_DAYS=7
# MAX_UPLOAD_MB=5
