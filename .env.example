# Copy to .env and fill in. .env is never served to browsers.
PORT=5173
HOST=127.0.0.1
NODE_ENV=development

# Supabase (Project settings → API). The server uses the secret service-role key;
# it is never sent to the browser. The anon key isn't needed by this app.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Business WhatsApp number that receives orders (country code, digits only).
# Admin → WhatsApp can override it.
WHATSAPP_BUSINESS_NUMBER=

# Cloudinary (Settings → API keys). Uploads are signed on the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: creates the first admin account on start-up if none exists yet
# (or run: npm run create-admin -- you@example.com "Name")
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Sanskriti

# Optional
# SESSION_DAYS=7
# MAX_UPLOAD_MB=5
